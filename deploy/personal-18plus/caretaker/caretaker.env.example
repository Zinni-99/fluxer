# Copy to /etc/fluxer-caretaker.env and fill in. Keep it private: chmod 600.
# Values with spaces or apostrophes must be in double quotes.

# Your instance's address, exactly as people open it.
FLUXER_URL=https://porchlite.xyz

# Admin API key. Create it in your admin panel (https://porchlite.xyz/admin,
# "Admin API Keys") with these permissions only:
#   instance:config:view instance:config:update registration:review
#   user:lookup user:view:dob report:view
# and, for the badge bot: badge:list badge:create badge:update
#   user:update:badges guild:lookup guild:list:members
FLUXER_ADMIN_API_KEY=

# Where the bots send alerts. Easiest: install the free ntfy app on your phone,
# subscribe to a long random topic name, and put its address here.
# A Discord or Slack webhook URL, Gotify or Apprise address also works.
NOTIFY_URL=https://ntfy.sh/replace-with-a-long-random-topic-name

# ---- Adults-only settings (used by "caretaker apply-settings") ----
INSTANCE_NAME="Porchlite"
BRAND_COLOR=#FFA53D
MIN_AGE=18
# approval = anyone can ask, you approve. closed = invite links only.
REGISTRATION_MODE=approval
# Where your TERMS.md, RULES.md and PRIVACY.md are published (no trailing slash).
LEGAL_BASE_URL=https://github.com/Zinni-99/fluxer/blob/main/deploy/personal-18plus/legal
NOTICE_MESSAGE="Welcome to Porchlite. 18+ only: by using this server you confirm you are an adult and accept the rules."

# true  = the age-gate bot approves anyone whose stated age is MIN_AGE or more.
# false = it only rejects under-age sign-ups and pings you to approve the rest.
AGE_GATE_AUTO_APPROVE=false

# ---- Badge bot ----
# The ID of your main community (right-click its icon, Copy ID, with developer
# mode on). Leave empty to turn the badge bot off.
BADGE_GUILD_ID=
# Peach Fuzz shows for this many days after someone joins, then goes away.
BADGE_PEACH_FUZZ_DAYS=14
# Everyone who joined before this date (YYYY-MM-DD) gets OG Porchlite for good.
BADGE_OG_BEFORE=
# Every other badge follows a server role with the same name, so a member with
# a "Brat Energy" role gets the Brat Energy badge, and loses it with the role.

# ---- Health bot ----
FLUXER_DIR=/opt/fluxer
REXCTL=/usr/local/bin/rexctl
MIN_FREE_DISK_GB=10

# ---- Off-site backups (optional, used by offsite-backup.sh) ----
# An rclone remote such as b2:my-fluxer-backups. Leave empty to skip.
OFFSITE_REMOTE=
OFFSITE_KEEP_DAYS=30
